# ═══════════════════════════════════════════════════════════════════════════════
# SignFlow CMS — installation settings
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env    then fill in the values below.
#   install-ubuntu.sh generates this file for you, with random secrets.
#
# ⚠️ Save this file as UTF-8 WITHOUT BOM. Notepad writes UTF-16, which breaks
#    docker compose in confusing ways (variables silently read as empty).

# ── Version and registry ───────────────────────────────────────────────────────
SIGNFLOW_REGISTRY=registry.dernoult.net:8443
# Pin an exact version in production. Tracking `latest` makes upgrades implicit
# and therefore irreproducible: two servers installed a month apart would not be
# running the same code.
SIGNFLOW_VERSION=1.0.24
# "Update available" bell in the top bar (org-admin only). The backend polls a
# public manifest and, when a newer version than the one above is published, shows
# the operator which version to install and the exact command. Set to false only
# if you do not want this notification. Default: true.
#SIGNFLOW_UPDATE_BELL=true

# ── Secrets — REPLACE EVERY ONE ───────────────────────────────────────────────
# Generate each value with:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_WORKER_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
CMS_JWT_SECRET=

# ── Where the media are stored ────────────────────────────────────────────────
# Host directory holding every media object (videos, images). This is the only
# dataset that grows without bound — point it at a large disk, not the system
# one. The directory must EXIST before the first start; the installer creates it.
# ⚠️ Local disk or iSCSI block device. Avoid NFS/CIFS: MinIO relies on POSIX
# semantics that file shares do not guarantee.
# ⚠️ Changing this after the first start does NOT move existing media — stop the
# stack and copy the directory across yourself.
MEDIA_DATA_PATH=/var/lib/signflow/media

# Vault for per-organisation AI API keys, encrypted at rest.
# ⚠️ MUST be a Fernet key: `openssl rand -base64 32`. An `openssl rand -hex 32`
#    value is REJECTED at startup — the formats differ.
# ⚠️ Losing it makes every stored API key permanently unreadable. Back it up.
CMS_VAULT_KEY=

# ── Public addresses ──────────────────────────────────────────────────────────
# The address BROWSERS and PLAYERS use to reach MinIO and download media
# (signed URLs). ⚠️ Never "localhost": every machine would query itself and no
# media would ever load.
#   local network example : 192.168.1.50:9000
#   public example        : media.example.com   (plus MINIO_PUBLIC_USE_SSL=true)
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=false

# Public URL of the CMS — used to build clickable links in outgoing email
# (campaign approvals, advertiser portal access).
#   example: https://signage.example.com
PUBLIC_WEB_URL=

# Origins allowed to call the API from a browser (JSON format).
# Empty is correct when the UI and the API share an origin — the default setup,
# since nginx serves both.
CORS_ORIGINS='[]'

# ── Time zone ─────────────────────────────────────────────────────────────────
# Governs how schedules and opening hours are interpreted.
# A wrong value shifts your entire playout.
SIGNFLOW_TZ=Europe/Paris

# ── Outgoing mail ─────────────────────────────────────────────────────────────
# Required for scheduled reports, email alerts and approval notifications.
# Leave SMTP_HOST empty to disable sending (everything else keeps working).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ── Artificial intelligence (optional) ────────────────────────────────────────
# Anthropic key for the built-in LiteLLM proxy. Without it the AI assistant and
# feed summaries are unavailable; the rest of the product works normally.
# Note: per-organisation AI keys are entered in the web interface, not here.
ANTHROPIC_API_KEY=

# ── Kahall ERP integration (optional) ─────────────────────────────────────────
# SignFlow is standalone. Fill these in only when a Kahall ERP is reachable;
# the integration is then opportunistic and never blocking.
ERP_API_URL=
ERP_SSO_ENABLED=false

# ── Conversational agent "Jeanine" (optional) ─────────────────────────────────
# Empty = messaging channel disabled.
CMS_TELEGRAM_BOT_TOKEN=
CMS_TELEGRAM_WEBHOOK_SECRET=

# ── Advanced tuning ───────────────────────────────────────────────────────────
# Leave empty: concurrency adapts itself to the machine's CPU and memory.
LIGHT_CONCURRENCY=
MEDIA_CONCURRENCY=
FFMPEG_THREADS=

# Interactive API documentation (/api/docs). Keep false in production:
# it exposes a complete map of the API.
CMS_DOCS_ENABLED=false

# MinIO listening interface. 0.0.0.0 = reachable from the network (players need this).
MINIO_BIND=0.0.0.0
