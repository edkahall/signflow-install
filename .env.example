# ═══════════════════════════════════════════════════════════════════════════════
# SignFlow CMS — configuration d'installation
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env    puis renseignez les valeurs ci-dessous.
#   install-ubuntu.sh génère ce fichier automatiquement, avec des secrets aléatoires.
#
# ⚠️ Éditez ce fichier en UTF-8 SANS BOM. Notepad enregistre en UTF-16 et casse
#    docker compose de façon déroutante (variables lues comme vides).

# ── Version et registre ────────────────────────────────────────────────────────
SIGNFLOW_REGISTRY=registry.dernoult.net:8443
# Épinglez une version précise en production. `latest` rend la mise à jour implicite,
# donc irreproductible : deux serveurs installés à un mois d'écart ne tourneraient
# pas le même code.
SIGNFLOW_VERSION=1.0.0

# ── Secrets — À REMPLACER, sans exception ─────────────────────────────────────
# Générez chaque valeur avec :  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_WORKER_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
CMS_JWT_SECRET=

# Coffre BYOK (clés API IA chiffrées au repos, §XXVII).
# ⚠️ DOIT être une clé Fernet : `openssl rand -base64 32`. Un `openssl rand -hex 32`
#    est REFUSÉ au démarrage — le format n'est pas le même.
# ⚠️ La perdre rend TOUTES les clés API stockées indéchiffrables. À sauvegarder.
CMS_VAULT_KEY=

# ── Adresses publiques ────────────────────────────────────────────────────────
# Adresse à laquelle les NAVIGATEURS et les PLAYERS joignent MinIO pour télécharger
# les médias (URL signées). ⚠️ Jamais « localhost » : chaque poste s'interrogerait
# lui-même et aucun média ne s'afficherait.
#   exemple LAN   : 192.168.1.50:9000
#   exemple public: medias.exemple.com    (+ MINIO_PUBLIC_USE_SSL=true)
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=false

# URL publique du CMS — sert à fabriquer les liens cliquables des e-mails
# (validation de campagne, accès au portail annonceur).
#   exemple : https://signage.exemple.com
PUBLIC_WEB_URL=

# Origines autorisées à appeler l'API depuis un navigateur (format JSON).
# Vide convient quand l'UI et l'API partagent la même origine — le cas par défaut,
# nginx servant les deux.
CORS_ORIGINS='[]'

# ── Fuseau horaire ────────────────────────────────────────────────────────────
# Détermine l'interprétation des programmations et des heures d'ouverture.
# Une erreur ici décale toute la diffusion.
SIGNFLOW_TZ=Europe/Paris

# ── Messagerie sortante ───────────────────────────────────────────────────────
# Requise pour : rapports planifiés, alertes par e-mail, notifications de validation.
# Laissez SMTP_HOST vide pour désactiver l'envoi (le reste fonctionne normalement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@exemple.com
SMTP_TLS=true

# ── Intelligence artificielle (optionnel) ─────────────────────────────────────
# Clé Anthropic du proxy LiteLLM interne. Sans elle, l'assistant IA et les résumés
# de flux sont indisponibles ; tout le reste du produit fonctionne.
# Note : les clés IA PAR ORGANISATION (BYOK) se saisissent dans l'interface, pas ici.
ANTHROPIC_API_KEY=

# ── Intégration ERP Kahall (optionnel) ────────────────────────────────────────
# SignFlow est autonome. Renseignez ces valeurs uniquement si un ERP Kahall est
# joignable ; l'intégration est alors opportuniste et jamais bloquante.
ERP_API_URL=
ERP_SSO_ENABLED=false

# ── Agent conversationnel « Jeanine » (optionnel) ─────────────────────────────
# Vides = canal de messagerie désactivé.
CMS_TELEGRAM_BOT_TOKEN=
CMS_TELEGRAM_WEBHOOK_SECRET=

# ── Réglages avancés ──────────────────────────────────────────────────────────
# Laissez vide : la concurrence s'adapte seule au CPU et à la RAM de la machine.
LIGHT_CONCURRENCY=
MEDIA_CONCURRENCY=
FFMPEG_THREADS=

# Documentation d'API interactive (/api/docs). Laissez false en production :
# elle expose la cartographie complète de l'API.
CMS_DOCS_ENABLED=false

# Interface d'écoute de MinIO. 0.0.0.0 = joignable du réseau (nécessaire aux players).
MINIO_BIND=0.0.0.0
